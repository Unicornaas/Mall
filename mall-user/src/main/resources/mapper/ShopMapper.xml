<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fjut.mall.user.mapper.ShopMapper">

    <resultMap id="BaseResultMap" type="edu.fjut.mall.user.entity.Shop">
        <id column="id" property="id"/>
        <result column="seller_id" property="sellerId"/>
        <result column="shop_name" property="shopName"/>
        <result column="logo" property="logo"/>
        <result column="contact_name" property="contactName"/>
        <result column="contact_phone" property="contactPhone"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectBySellerId" resultMap="BaseResultMap">
        SELECT * FROM shop_t WHERE seller_id = #{sellerId}
    </select>

    <insert id="insert">
        INSERT INTO shop_t (id, seller_id, shop_name, logo, contact_name, contact_phone, description, status)
        VALUES (#{id}, #{sellerId}, #{shopName}, #{logo}, #{contactName}, #{contactPhone}, #{description}, #{status})
    </insert>
</mapper>
