<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fjut.mall.order.mapper.OrderItemMapper">
    <resultMap id="BaseResultMap" type="edu.fjut.mall.order.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="seller_id" property="sellerId"/>
        <result column="seller_order_id" property="sellerOrderId"/>
        <result column="spu_id" property="spuId"/>
        <result column="sku_id" property="skuId"/>
        <result column="product_name" property="productName"/>
        <result column="product_image" property="productImage"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="shipped_quantity" property="shippedQuantity"/>
        <result column="refunded_quantity" property="refundedQuantity"/>
        <result column="shipping_company" property="shippingCompany"/>
        <result column="tracking_no" property="trackingNo"/>
        <result column="ship_time" property="shipTime"/>
        <result column="total_price" property="totalPrice"/>
    </resultMap>
    <insert id="insertBatch">
        INSERT INTO order_item (id, order_id, seller_id, seller_order_id, spu_id, sku_id, product_name, product_image, price, quantity, total_price) VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.id}, #{item.orderId}, #{item.sellerId}, #{item.sellerOrderId}, #{item.spuId}, #{item.skuId}, #{item.productName}, #{item.productImage}, #{item.price}, #{item.quantity}, #{item.totalPrice})
        </foreach>
    </insert>
    <select id="selectByOrderId" resultMap="BaseResultMap">SELECT * FROM order_item WHERE order_id = #{orderId}</select>
    <select id="selectByOrderIdAndSellerId" resultMap="BaseResultMap">
        SELECT * FROM order_item WHERE order_id = #{orderId} AND seller_id = #{sellerId}
    </select>
    <select id="selectBySellerOrderIdAndSellerId" resultMap="BaseResultMap">
        SELECT * FROM order_item
        WHERE seller_order_id = #{sellerOrderId} AND seller_id = #{sellerId}
        ORDER BY id
    </select>
</mapper>
