<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fjut.mall.payment.mapper.PaymentInfoMapper">
    <resultMap id="BaseResultMap" type="edu.fjut.mall.payment.entity.PaymentInfo">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="amount" property="amount"/>
        <result column="refund_amount" property="refundAmount"/>
        <result column="pay_type" property="payType"/>
        <result column="pay_status" property="payStatus"/>
        <result column="trade_no" property="tradeNo"/>
        <result column="pay_time" property="payTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO payment_info (id, order_no, user_id, amount, pay_type, pay_status)
        VALUES (#{id}, #{orderNo}, #{userId}, #{amount}, #{payType}, #{payStatus})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM payment_info WHERE id = #{id}
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM payment_info WHERE order_no = #{orderNo} LIMIT 1
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM payment_info ORDER BY id DESC LIMIT #{pageSize} OFFSET #{pageNum}
    </select>

    <update id="updateStatus">
        UPDATE payment_info SET pay_status = #{payStatus} WHERE id = #{id}
    </update>

    <update id="updateRefundAmount">
        UPDATE payment_info SET refund_amount = #{refundAmount}, pay_status = #{payStatus}
        WHERE id = #{id}
    </update>

    <update id="updateTradeNo">
        UPDATE payment_info SET trade_no = #{tradeNo}, pay_time = NOW() WHERE id = #{id}
    </update>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM payment_info
    </select>

    <sql id="AdminPaymentWhere">
        <where>
            <if test="query.orderNo != null and query.orderNo != ''">
                AND order_no LIKE CONCAT('%', #{query.orderNo}, '%')
            </if>
            <if test="query.payStatus != null">
                AND pay_status = #{query.payStatus}
            </if>
        </where>
    </sql>

    <select id="selectPageForAdmin" resultMap="BaseResultMap">
        SELECT * FROM payment_info
        <include refid="AdminPaymentWhere"/>
        ORDER BY create_time DESC, id DESC
        LIMIT #{query.offset}, #{query.pageSize}
    </select>

    <select id="countForAdmin" resultType="long">
        SELECT COUNT(*) FROM payment_info
        <include refid="AdminPaymentWhere"/>
    </select>
</mapper>
