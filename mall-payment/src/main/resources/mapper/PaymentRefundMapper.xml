<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fjut.mall.payment.mapper.PaymentRefundMapper">
    <resultMap id="BaseResultMap" type="edu.fjut.mall.payment.entity.PaymentRefund">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="refund_amount" property="refundAmount"/>
        <result column="refund_status" property="refundStatus"/>
        <result column="reason" property="reason"/>
        <result column="processor_id" property="processorId"/>
        <result column="process_remark" property="processRemark"/>
        <result column="process_time" property="processTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <resultMap id="RefundItemResultMap" type="edu.fjut.mall.payment.entity.PaymentRefundItem">
        <id column="id" property="id"/>
        <result column="refund_id" property="refundId"/>
        <result column="order_item_id" property="orderItemId"/>
        <result column="seller_order_id" property="sellerOrderId"/>
        <result column="sku_id" property="skuId"/>
        <result column="product_name" property="productName"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="refund_amount" property="refundAmount"/>
        <result column="item_status" property="itemStatus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO payment_refund (id, order_no, user_id, refund_amount, refund_status, reason)
        VALUES (#{id}, #{orderNo}, #{userId}, #{refundAmount}, #{refundStatus}, #{reason})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM payment_refund WHERE id = #{id}
    </select>

    <select id="selectLatestByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM payment_refund WHERE order_no = #{orderNo}
        ORDER BY create_time DESC, id DESC LIMIT 1
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM payment_refund WHERE order_no = #{orderNo}
        ORDER BY create_time DESC, id DESC
    </select>

    <update id="updateStatus">
        UPDATE payment_refund SET refund_status = #{refundStatus} WHERE id = #{id}
    </update>

    <update id="updateProcess">
        UPDATE payment_refund
        SET refund_status = #{refundStatus}, processor_id = #{processorId},
            process_remark = #{processRemark}, process_time = NOW()
        WHERE id = #{id} AND refund_status = 0
    </update>

    <sql id="AdminRefundWhere">
        <where>
            <if test="query.orderNo != null and query.orderNo != ''">
                AND order_no LIKE CONCAT('%', #{query.orderNo}, '%')
            </if>
            <if test="query.refundStatus != null">
                AND refund_status = #{query.refundStatus}
            </if>
        </where>
    </sql>

    <select id="selectPageForAdmin" resultMap="BaseResultMap">
        SELECT * FROM payment_refund
        <include refid="AdminRefundWhere"/>
        ORDER BY create_time DESC, id DESC
        LIMIT #{query.offset}, #{query.pageSize}
    </select>

    <select id="countForAdmin" resultType="long">
        SELECT COUNT(*) FROM payment_refund
        <include refid="AdminRefundWhere"/>
    </select>

    <insert id="insertItem">
        INSERT INTO payment_refund_item
        (id, refund_id, order_item_id, seller_order_id, sku_id, product_name,
         price, quantity, refund_amount, item_status)
        VALUES
        (#{id}, #{refundId}, #{orderItemId}, #{sellerOrderId}, #{skuId}, #{productName},
         #{price}, #{quantity}, #{refundAmount}, #{itemStatus})
    </insert>

    <select id="selectItemsByRefundId" resultMap="RefundItemResultMap">
        SELECT * FROM payment_refund_item WHERE refund_id = #{refundId} ORDER BY id
    </select>

    <update id="updateItemStatus">
        UPDATE payment_refund_item SET item_status = #{itemStatus}
        WHERE refund_id = #{refundId}
    </update>
</mapper>
